<script type="text/javascript" src="/js/multiselect.min.js"></script>

<% if (req.query.page == 'myserver' && req.query.setting == 'lvl_system') {%>
<script type="text/javascript">
jQuery(document).ready(function($) {
    $('#customSort1').multiselect({
        sort: {
            left: function(a, b) {
                return a.value > b.value ? 1 : -1;
            },
            right: function(a, b) {
                return a.value > b.value ? -1 : 1;
            }
        }
    });
});
</script>
<script type="text/javascript">
    jQuery(document).ready(function($) {
        $('#customSort2').multiselect({
            sort: {
                left: function(a, b) {
                    return a.value > b.value ? 1 : -1;
                },
                right: function(a, b) {
                    return a.value > b.value ? -1 : 1;
                }
            }
        });
    });
    </script>
<% } %>

<% if (req.query.page == 'myserver' && req.query.setting == 'voice'|| req.query.page == 'myserver' && req.query.setting == 'auto_role') {%>
